#!/usr/bin/env bash
# Build a resume PDF from a content file. The single place the typst
# invocation lives - it used to be duplicated verbatim across three docs,
# which drifted independently.
#
# No rendered PDF is written into the content folder, which is usually a
# repository. A review build goes to the temp folder; a send-ready copy goes
# where -o says, and an -o inside the current folder or the content file's
# folder is refused.
#
# Usage:
#   bin/build <content.yaml>              review build, <temp>/<stem>.pdf
#   bin/build <content.yaml> -o <folder>/ "<name> Resume.pdf" in <folder>
#   bin/build <content.yaml> -o <out.pdf> PDF at <out.pdf>
set -euo pipefail

usage() {
  echo "usage: bin/build <content-file> [-o <output.pdf or folder/>]" >&2
  exit 1
}

[[ $# -ge 1 ]] || usage

content_arg="$1"
shift
output_arg=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -o)
      [[ $# -ge 2 ]] || usage
      output_arg="$2"
      shift 2
      ;;
    *)
      usage
      ;;
  esac
done

# skill_dir anchors the template, components and fonts this script ships
# with. Computed from this script's own location, not from $HOME, so it
# works even when the skill is reached only through a plugin symlink. -P
# resolves through that symlink before applying `..`, so a relative
# argument still lands on the real directory rather than a path back
# through the link.
skill_dir="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Path resolution: a relative argument resolves against where the user
# actually ran the command from, not against this script's own location.
# Captured once, before anything below changes directory.
orig_dir="$(pwd)"

resolve_path() {
  case "$1" in
    /*) printf '%s\n' "$1" ;;
    *) printf '%s\n' "$orig_dir/$1" ;;
  esac
}

content="$(resolve_path "$content_arg")"
[[ -f "$content" ]] || { echo "content file not found: $content" >&2; exit 1; }

# Where an -o lands: a leading ~ expanded (a quoted "~/..." arrives here
# unexpanded), resolved against the folder this was run from with symlinks
# followed, named "<name> Resume.pdf" when it is a folder, then refused when
# inside the current folder or the content file's folder. A relative -o is
# therefore always refused. Python, because resolving a path that does not
# exist yet is not portable between macOS and Linux shells. Read into a
# variable rather than written as a heredoc inside $( ), which bash 3.2
# misparses when the code holds an apostrophe.
read -r -d '' place_output <<'PYEOF' || true
import os
import sys

cwd, content, given = sys.argv[1:]
path = os.path.realpath(os.path.join(cwd, os.path.expanduser(given)))
if given.endswith("/") or os.path.isdir(path):
    # Only the folder form reads the content, so a build with a file -o
    # works without pyyaml.
    import yaml
    with open(content, encoding="utf-8") as handle:
        data = yaml.safe_load(handle)
    name = data.get("name") if isinstance(data, dict) else None
    if not name:
        sys.exit(f"no name in {content} to name the PDF by; give -o a file path")
    path = os.path.join(path, f"{name} Resume.pdf")
for folder, label in ((os.path.realpath(cwd), "the current folder"),
                      (os.path.realpath(os.path.dirname(content)), "the content file's folder")):
    if os.path.commonpath([path, folder]) == folder:
        sys.exit(f"refusing to write {path}: it is inside {label}, {folder}")
print(path)
PYEOF

if [[ -n "$output_arg" ]]; then
  output="$(python3 -c "$place_output" "$orig_dir" "$content" "$output_arg")"
else
  # Default: a review build, to the temp folder, never beside the content
  # file. ${TMPDIR%/} because macOS sets TMPDIR with a trailing slash.
  temp_folder="${TMPDIR:-/tmp}"
  output="${temp_folder%/}/$(basename "${content%.*}").pdf"
fi

case "$output" in
  *.yaml|*.yml)
    echo "refusing to write output over a .yaml file: $output" >&2
    exit 1
    ;;
esac

mkdir -p "$(dirname "$output")"

# --root / and absolute paths for content, fonts, and template are required:
# Typst sandboxes relative reads to its own project root (the template's own
# directory), so when content lives outside the skill dir (the normal case
# here), only an absolute path under an unrestricted root can reach it.
#
# --ignore-system-fonts keeps the render host-independent: only the committed
# faces under $skill_dir/fonts are used, never whatever the machine has
# installed. A host with system fonts present measurably shifts baselines
# (1.83pt versus 0.75pt against the golden reference), so without this flag
# the same content renders differently on a laptop and on a CI runner.
typst compile --root / --ignore-system-fonts \
  --input "content=$content" \
  --font-path "$skill_dir/fonts" \
  "$skill_dir/template.typ" \
  "$output"

echo "built $output"
